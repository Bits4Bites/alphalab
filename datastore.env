# Data store config (Redis)

## Redis connection URL,
## - full format for non-SSL: redis://[:password@]host:port/db
## - full format for SSL: rediss://[:password@]host:port/db
AL_DATASTORE_REDIS_URL=redis://localhost:6379/0

## (Optional) Key prefix for all keys stored in Redis, to avoid conflicts with other applications using the same Redis instance.
AL_DATASTORE_KEY_PREFIX="alphalab:"
